    { "foreground": "status-negative", "background": "status-negative-soft", "min": 4.5, "why": "status text on its ground" },
    { "foreground": "status-info", "background": "status-info-soft", "min": 4.5, "why": "status text on its ground" },
    { "foreground": "status-negative", "background": ["background-normal", "background-elevated"], "min": 4.5, "why": "error text on the page and in cards (FieldError, a destructive Alert's description, a destructive menu item)" },
