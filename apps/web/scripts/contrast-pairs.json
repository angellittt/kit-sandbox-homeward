    { "foreground": "on-secondary", "background": "secondary-normal", "min": 4.5, "why": "text on the secondary fill" },
    { "foreground": "on-accent", "background": "accent-normal", "min": 4.5, "why": "text on the accent fill" },
    { "foreground": "status-positive", "background": "status-positive-soft", "min": 4.5, "why": "status text on its ground" },
